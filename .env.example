# Copy to .env (gitignored) and fill in. Never commit real values.
# In GitHub Actions these come from repository secrets instead.

# Unity Catalog catalog for the bronze/silver/gold schemas
F1F_CATALOG=f1_forecast

# Local caches for downloaded API responses
DATA_CACHE_DIR=./data/cache
FASTF1_CACHE_DIR=./data/fastf1_cache

# Phase 6 (news extraction); leave blank until the LLM choice is made
LLM_PROVIDER=
LLM_API_KEY=

# Databricks credentials do NOT go here. They live in the project-local,
# gitignored .databrickscfg, used through scripts/dbx.cmd (see README).
